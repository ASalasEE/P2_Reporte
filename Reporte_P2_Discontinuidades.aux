\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Curva de \ang {90}: densidad de carga superficial $|\rho _s|$ (izquierda) y densidad de corriente superficial $|\mathbf  {J}_s|$ con sus líneas de flujo (derecha), calculadas con \eqref  {eq:saltos} a partir de los campos de HFSS a \SI {5}{GHz}, para (a) la curva sin chaflán y (b) la curva con chaflán. Ambas están normalizadas a su promedio en una sección del brazo situada a $2.5W$ de la esquina; los factores indicados son promedios en un cuadrado de lado $W/4$ en cada esquina, o en una franja de ancho $W/4$ a lo largo del chaflán.}}{13}{figure.caption.17}\protected@file@percent }
\newlabel{fig:carga}{{9}{13}{Curva de \ang {90}: densidad de carga superficial $|\rho _s|$ (izquierda) y densidad de corriente superficial $|\mathbf {J}_s|$ con sus líneas de flujo (derecha), calculadas con \eqref {eq:saltos} a partir de los campos de HFSS a \SI {5}{GHz}, para (a) la curva sin chaflán y (b) la curva con chaflán. Ambas están normalizadas a su promedio en una sección del brazo situada a $2.5W$ de la esquina; los factores indicados son promedios en un cuadrado de lado $W/4$ en cada esquina, o en una franja de ancho $W/4$ a lo largo del chaflán}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Tamaño de la esquina frente a la longitud de onda guiada. A la izquierda, la curva y la coordenada $s$ a lo largo del eje de la línea. A la derecha, una instantánea de la onda guiada, $\cos (2\pi s/\lambda _g)$, a 2, 7 y \SI {20}{GHz} en función de $s$. La franja marca la zona de la esquina (su diagonal, $W\sqrt  {2}=\SI {1.61}{mm}$), el tramo negro es la parte de la onda que cae dentro de ella y $\Delta \phi $ es el desfase de la onda a través de la esquina.}}{14}{figure.caption.19}\protected@file@percent }
\newlabel{fig:escala}{{10}{14}{Tamaño de la esquina frente a la longitud de onda guiada. A la izquierda, la curva y la coordenada $s$ a lo largo del eje de la línea. A la derecha, una instantánea de la onda guiada, $\cos (2\pi s/\lambda _g)$, a 2, 7 y \SI {20}{GHz} en función de $s$. La franja marca la zona de la esquina (su diagonal, $W\sqrt {2}=\SI {1.61}{mm}$), el tramo negro es la parte de la onda que cae dentro de ella y $\Delta \phi $ es el desfase de la onda a través de la esquina}{figure.caption.19}{}}
